# Copy this file to .env and fill in real values.
# Never commit .env to version control.

ENV=development
LOG_LEVEL=INFO

# Database (Postgres recommended for production; SQLite works for local dev)
# DATABASE__URL=postgresql+psycopg2://user:password@localhost:5432/lead_intelligence
DATABASE__URL=sqlite:///./lead_intelligence.db
DATABASE__ECHO_SQL=false

# AI providers
AI__ANTHROPIC_API_KEY=sk-ant-...
AI__OPENAI_API_KEY=sk-...           # optional
AI__DEFAULT_MODEL=claude-sonnet-4-6

# Crawling
CRAWLING__MAX_CONCURRENT_REQUESTS=10
CRAWLING__REQUEST_TIMEOUT_SECONDS=30

# Ingestion sources
INGESTION__NEWS_API_KEY=...         # newsapi.org key

# Scoring
SCORING__LEAD_THRESHOLD=60.0
